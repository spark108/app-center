<Window x:Class="Spark108.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Spark108 App Center" Width="1250" Height="790" MinWidth="900" MinHeight="670"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0A111F" FontFamily="Segoe UI" Foreground="#EEF4FF" Loaded="WindowLoaded" Closing="WindowClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A0B3CD" />
        <SolidColorBrush x:Key="Text" Color="#EEF4FF" />
        <SolidColorBrush x:Key="Accent" Color="#FFD16C" />
        <SolidColorBrush x:Key="Outline" Color="#2B3B56" />
        <Style TargetType="Button" x:Key="ControlButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#172438" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#91ACD0" />
                                <Setter TargetName="Frame" Property="Opacity" Value=".86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".67" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFD16C" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".38" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#1C160C" />
            <Setter Property="Padding" Value="21,10" />
        </Style>
        <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource ControlButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="39" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Width" Value="47" />
            <Setter Property="Height" Value="47" />
            <Setter Property="Margin" Value="0,0,0,11" />
        </Style>
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#172438" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemFrame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#2B4563" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionBox" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="MinWidth" Value="99" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="#40526D" Background="#172438">
                                            <TextBlock Text="⌄" Margin="0,0,10,2" Foreground="#B5C6DE"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock IsHitTestVisible="False" Margin="10,0,24,0" VerticalAlignment="Center"
                                       Text="{Binding SelectedItem.Version, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                <Border BorderBrush="#40526D" BorderThickness="1" Background="#172438"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="270">
                                    <ScrollViewer CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardSelection" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#101B2D" BorderBrush="#2A3C56" BorderThickness="1"
                                CornerRadius="13" Padding="13" Width="222" Height="110">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#172740" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FFD16C" />
                                <Setter TargetName="Card" Property="Background" Value="#1B2B42" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#FFD16C" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="43" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="67" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="3" Background="#0C1526" BorderBrush="#213149" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Top" Width="39" Height="39" Margin="0,12,0,22" Background="#24374E" CornerRadius="11">
                    <TextBlock Text="✦" FontSize="25" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel x:Name="Navigation" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Button x:Name="CatalogButton" Style="{StaticResource NavButton}" Content="&#xE80A;" ToolTip="Каталог"
                            AutomationProperties.Name="Каталог" Click="CatalogClick" />
                    <Button x:Name="LibraryButton" Style="{StaticResource NavButton}" Content="&#xE8B7;" ToolTip="Библиотека"
                            AutomationProperties.Name="Библиотека" Click="LibraryClick" />
                    <Button x:Name="UpdatesButton" Style="{StaticResource NavButton}" Content="&#xE896;" ToolTip="Обновления"
                            AutomationProperties.Name="Обновления" Click="UpdatesClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#0C1525" MouseLeftButtonDown="TitleDrag">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                <Run Text="Spark108" /><Run Text="  App Center" Foreground="{StaticResource Muted}" />
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                <StackPanel x:Name="AccountPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,15,0">
                    <TextBlock x:Name="AccountName" MaxWidth="205" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="LogOutButton" Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Выйти из учётной записи"
                            AutomationProperties.Name="Выйти из учётной записи" Click="LogoutClick" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="MinimizeClick" AutomationProperties.Name="Свернуть" />
                <Button Style="{StaticResource IconButton}" Content="&#xE922;" Click="MaximizeClick" AutomationProperties.Name="Развернуть или восстановить" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseClick" AutomationProperties.Name="Закрыть" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Welcome" Grid.Column="1" Grid.Row="1">
            <Grid.Background><ImageBrush ImageSource="Assets/infrastructure.jpg" Stretch="UniformToFill" AlignmentX="Right" /></Grid.Background>
            <Rectangle>
                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#E4081325" /><GradientStop Offset=".46" Color="#AF081325" /><GradientStop Offset="1" Color="#15081325" />
                </LinearGradientBrush></Rectangle.Fill>
            </Rectangle>
            <StackPanel Margin="54,28,24,34" MaxWidth="538" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="SPARK108  /  WINDOWS" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="App Center" FontSize="68" FontWeight="Bold" Margin="0,3,0,5" />
                <TextBlock Text="Корпоративные приложения и служебные компоненты в одном каталоге."
                           TextWrapping="Wrap" FontSize="21" Foreground="#B9CBE3" Margin="0,0,0,25" MaxWidth="450" HorizontalAlignment="Left" />
                <Button x:Name="SignIn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="LoginClick"
                        Content="Войти через Alathea Auth" Padding="22,12" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Workspace" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Margin="27,10,27,10">
            <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="305" /><RowDefinition Height="173" /></Grid.RowDefinitions>
            <Border CornerRadius="18" BorderBrush="#2A3C55" BorderThickness="1" ClipToBounds="True">
                <Border.Background><ImageBrush ImageSource="Assets/infrastructure.jpg" Stretch="UniformToFill" AlignmentX="Right" /></Border.Background>
                <Grid>
                    <Rectangle RadiusX="17" RadiusY="17">
                        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#F2091427" /><GradientStop Offset=".50" Color="#E00B1729" />
                            <GradientStop Offset="1" Color="#23071325" />
                        </LinearGradientBrush></Rectangle.Fill>
                    </Rectangle>
                    <StackPanel x:Name="EmptySelection" Margin="35" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" FontSize="39" FontWeight="Bold" />
                        <TextBlock x:Name="EmptyHint" FontSize="16" Foreground="{StaticResource Muted}" Margin="1,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid x:Name="Details" Margin="34,24,32,24" MaxWidth="670" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="AppType" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="AppTitle" Grid.Row="1" FontSize="43" FontWeight="Bold" Margin="0,3,0,5"
                                   TextTrimming="CharacterEllipsis" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="575"
                                      HorizontalAlignment="Left" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock x:Name="AppDescription" TextWrapping="Wrap" FontSize="17" Foreground="#D4E0F0" />
                                <TextBlock x:Name="DependencyText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
                                <TextBlock x:Name="ReleaseNotes" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,11" Height="30">
                            <TextBlock x:Name="VersionLabel" Text="Версия" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,9,0" />
                            <ComboBox x:Name="Versions" Style="{StaticResource VersionBox}"
                                      AutomationProperties.Name="Доступные версии" SelectionChanged="VersionChanged">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Version}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="InstalledLabel" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Row="4" x:Name="Actions">
                            <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="InstallClick" Margin="0,0,8,0" />
                            <Button x:Name="LaunchButton" Style="{StaticResource ControlButton}" Content="Открыть" Click="LaunchClick" Margin="0,0,8,0" />
                            <Button x:Name="DownloadButton" Style="{StaticResource ControlButton}" Content="Скачать ZIP" Click="DownloadClick" Margin="0,0,8,0" />
                            <Button x:Name="RemoveButton" Style="{StaticResource ControlButton}" Content="Удалить" Click="RemoveClick" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#101B2D" BorderBrush="#2A3C56" BorderThickness="1" CornerRadius="7" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,5,0" />
                                <TextBox x:Name="Search" Width="145" Padding="1,4" FontSize="13" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}" ToolTip="Поиск по названию"
                                         AutomationProperties.Name="Поиск по названию" TextChanged="SearchChanged" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="RefreshButton" Style="{StaticResource ControlButton}" Height="29" Padding="9,0" FontSize="12"
                                Content="Проверить обновления" Click="RefreshClick" />
                    </StackPanel>
                    <TextBlock x:Name="SectionTitle" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="Cards" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,4,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource CardSelection}"
                         AutomationProperties.Name="Приложения" SelectionChanged="AppChanged" PreviewMouseWheel="ScrollCards">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{Binding TileBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F0F6FF" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11"
                                           VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Background="#0C1525" BorderBrush="#213149" BorderThickness="0,1,0,0">
            <DockPanel Margin="22,0,16,0">
                <TextBlock x:Name="ClientBuild" DockPanel.Dock="Right" Foreground="#7F95B2" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource ControlButton}" Height="27" Padding="8,0"
                        FontSize="12" Content="Отмена" Click="CancelClick" Visibility="Collapsed" />
                <ProgressBar x:Name="OperationProgress" DockPanel.Dock="Right" Margin="12,0,12,0" Height="5" Width="108"
                             Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="#263854" />
                <TextBlock x:Name="StatusText" Text="Требуется вход" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
